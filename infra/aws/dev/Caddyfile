{
	admin off
	servers {
		protocols h1 h2
	}
}

{$NOMI_DOMAIN} {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# Health probes and the Identity authentication contract are public entry points.
	@academic {
		method GET HEAD
		path /academic/health/live /academic/health/ready
	}
	handle @academic {
		uri strip_prefix /academic
		reverse_proxy academic:8080 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}

	# Academic v1 is authenticated by the API; Caddy only removes the public prefix.
	@academicApi {
		path /academic/api/v1/*
	}
	handle @academicApi {
		uri strip_prefix /academic
		reverse_proxy academic:8080 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}

	@assistant {
		method GET HEAD
		path /assistant/health/live /assistant/health/ready
	}
	handle @assistant {
		uri strip_prefix /assistant
		reverse_proxy assistant:8080 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}

	# Assistant v1 (audio upload slots and transcriptions) is authenticated by the API.
	@assistantApi {
		path /assistant/api/v1/*
	}
	handle @assistantApi {
		uri strip_prefix /assistant
		request_body {
			max_size 64KB
		}
		reverse_proxy assistant:8080 {
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
			}
		}
	}

	@notifications {
		method GET HEAD
		path /notifications/health/live /notifications/health/ready
	}
	handle @notifications {
		uri strip_prefix /notifications
		reverse_proxy notifications:8080 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}

	@identityHealth {
		method GET HEAD
		path /identity/health/live /identity/health/ready
	}
	handle @identityHealth {
		uri strip_prefix /identity
		reverse_proxy identity:8080
	}

	@identityAuth {
		method POST
		path /v1/auth/google /v1/auth/register /v1/auth/register/start /v1/auth/register/confirm /v1/auth/register/resend /v1/auth/login /v1/auth/password/recovery/start /v1/auth/password/recovery/verify /v1/auth/password/reset /v1/auth/refresh /v1/auth/logout
	}
	handle @identityAuth {
		reverse_proxy identity:8080
	}

	@identityMe {
		method GET
		path /v1/auth/me
	}
	handle @identityMe {
		reverse_proxy identity:8080
	}

	handle {
		respond "Not found" 404
	}
}
